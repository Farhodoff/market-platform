 Альфа-Банку за добросовестную работу онлайн и офлайн. Спасибо за то, что делаете всё для людей. Замечательный банк с очень выгодными предложениями."},{"name":"Таисия Авдеева","text":"Пользуюсь кредитной картой Альфа-Банка 100 дней без процентов уже 6 лет. Радует длительный беспроцентный период, бесплатное снятие наличных, а также повышенный кешбек!"}],"blockView":{"cards":true,"banner":true,"cashback":true,"feedback":true,"disclaimer":true},"formLinks":{"only":"https:\u002F\u002Falfa.me\u002FPN1hUy","rule":"https:\u002F\u002Falfabank.servicecdn.ru\u002Fsite-upload\u002F92\u002Fb0\u002F212\u002FLoyalty_program_rules_reversible_CashBack_v37.pdf","debit":"https:\u002F\u002Fxplatform.alfabank.ru\u002Funiversal-dc-form-web-ui\u002Fyandex-questionnaire\u002Fquestionnaire?utm=yandexlavka","credit":"https:\u002F\u002Falfa.me\u002F1bwRAH","travel":"https:\u002F\u002Falfa.me\u002F4HE1ts","details":"","sticker":"https:\u002F\u002Falfa.me\u002Fhxkhf6"}},"download_app_deeplink":{"deeplink":"https:\u002F\u002Ffy7t.adj.st\u002Fexternal?service=grocery&href=%2Fcart&adj_t=aklqcc3_u5imfiy&adj_fallback=https%3A%2F%2Flavka.yandex.ru%2F&adj_redirect_macos=https%3A%2F%2Flavka.yandex.ru%2F"},"conditional-discount":{"enabled":false},"fix-delivery-type":{"enabled":true,"withFallback":true,"withRoverDay":true},"logging-settings":{"frameDelayTimeout":30000},"desktop_grocery-payment-flow":{"enabled":false},"favicon":{},"ui_theme":{"preset":"lavka","brandColor":"#00adff"},"adult-verification-flow":{"static":{"modelPath":"https:\u002F\u002Fyastatic.net\u002Fs3\u002Fgrocery-superapp\u002Fstatic\u002Fpassport-validation\u002Fmodels\u002F","libraryPath":"https:\u002F\u002Fyastatic.net\u002Fs3\u002Fgrocery-superapp\u002Fstatic\u002Fpassport-validation\u002Fai-passport-validation.js","photoSelfieImage":"https:\u002F\u002Favatars.mds.yandex.net\u002Fget-bunker\u002F128809\u002Ff268eece936912f3a4eafefddb20208802c7153c\u002Forig","photoWarningImage":"https:\u002F\u002Favatars.mds.yandex.net\u002Fget-bu